# Used only to sign/broadcast the deployment transaction — pays gas.
# For testnet: generate a fresh wallet you don't use anywhere else (e.g. `cast wallet new`)
# and fund it from a HyperEVM testnet faucet. Never put a mainnet key with real funds here.
DEPLOYER_PRIVATE_KEY=

# Holds DEFAULT_ADMIN_ROLE on both contracts — can grant/revoke MINTER_ROLE (e.g. to
# rotate signers). Should be a different, more carefully guarded address than the deployer
# and the minter below.
CONTRACT_ADMIN_ADDRESS=

# The backend's signer address (HYPEREVM_SIGNER_PRIVATE_KEY's corresponding address in
# vibbe-backend). Holds MINTER_ROLE — the only address allowed to call mint() on either
# contract.
BACKEND_MINTER_ADDRESS=
